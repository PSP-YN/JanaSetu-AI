# Copy this file to .env.local and replace the placeholders with values from the dedicated JanaSetu Supabase project.
# Use a Supabase publishable key (sb_publishable_...). Never put a service_role/secret key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace_me
